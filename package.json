{
  "name": "lazaret",
  "version": "0.0.0",
  "private": true,
  "description": "Supply-chain blast radius over a HydraDB dependency graph. When an npm package is compromised, answer which of your services were actually exposed, with the dependency path as evidence.",
  "license": "MIT",
  "author": "winsznx",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:claims": "tsx scripts/check-claims.ts",
    "seed:fixture": "tsx apps/ingest/src/cli.ts seed-fixture",
    "stats": "tsx apps/ingest/src/cli.ts stats",
    "verify": "tsx apps/ingest/src/cli.ts verify && pnpm run check:claims",
    "repro": "bash scripts/repro.sh",
    "evidence": "tsx scripts/gen-evidence.ts",
    "campaign:fetch": "tsx scripts/campaign-fetch.ts",
    "campaign:run": "tsx scripts/campaign-run.ts",
    "lazaret": "tsx scripts/lazaret.ts",
    "api": "tsx apps/api/src/index.ts",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:claims"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "neo4j-driver": "^5.19.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
