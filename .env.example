# HydraDB connection
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_BOLT_URL=neo4j://127.0.0.1:7687
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH=default
HYDRADB_NAMESPACE=default
HYDRADB_CELL_ID=cell-0

# Advisory ingest. OSV works without a token; GitHub Advisory enrichment needs one.
GITHUB_TOKEN=

# npm registry crawl
NPM_REGISTRY=https://registry.npmjs.org
CRAWL_CONCURRENCY=48
